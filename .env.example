# gog CLI (for Google Meet scheduling)
# Install: brew install gogcli
# Authenticate: gog auth add <email> --services calendar
# See https://gogcli.sh/quickstart.html

# Resend (for email notifications)
# Get API key: https://resend.com/api-keys
RESEND_API_KEY="re_..."
EMAIL_FROM="HermesHire <notifications@hermes-hire.xyz>"

# Uploadthing (for file uploads)
# Get keys: https://uploadthing.com/dashboard
UPLOADTHING_SECRET="sk_live_..."
UPLOADTHING_APP_ID="hermes-hire"
