# Neon PostgreSQL connection string
DATABASE_URL="postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/hermes-hire?sslmode=require&pgbouncer=true"

# Hermes Agent API (used for AI features)
HERMES_API_KEY=""
